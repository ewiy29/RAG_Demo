# Base URL the browser uses to reach the RAG API.
# Leave empty to use same-origin requests, which the Vite dev server proxies to
# the backend (see vite.config.ts). Set an absolute URL for a deployed API, e.g.
# VITE_API_BASE_URL=https://rag.example.com
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards API calls (dev only). Defaults to the local
# uvicorn address.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
