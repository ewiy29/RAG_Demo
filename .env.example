# Copy to .env and fill in values. The app reads these at startup.
# For running the test suite you do NOT need any of these: the suite injects an
# offline fake provider + in-memory stores directly (see tests/doubles).

# OpenAI credentials + models. OpenAI is the only shipped provider.
OPENAI_API_KEY=sk-your-key-here
RAG_CHAT_MODEL=gpt-5.4-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vector store persistence directory (Chroma)
RAG_PERSIST_DIR=.chroma
RAG_COLLECTION=rag_demo

# Uploads are processed entirely in memory and never written to disk; only the
# derived vectors (Chroma) are persisted.
# Largest single upload the API accepts, in bytes (default 10 MiB)
RAG_MAX_UPLOAD_BYTES=10485760

# CORS: comma-separated browser origins allowed to call the API (the React UI).
# "*" allows any origin (fine for a local demo).
RAG_CORS_ALLOW_ORIGINS=*

# Retrieval / chunking tuning
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# Conversation state (multi-turn /chat). Redis is the hot layer; leave
# RAG_REDIS_URL unset to use an in-process fakeredis fallback (no server).
# RAG_REDIS_URL=redis://localhost:6379/0
RAG_SESSION_TTL_SECONDS=86400
RAG_CONVERSATION_DURABLE_PATH=conversations.sqlite3
RAG_CONVERSATION_HISTORY_LIMIT=10

# Logging: DEBUG | INFO | WARNING | ERROR
RAG_LOG_LEVEL=INFO
