# Copy to .env and fill in values. The app reads these at startup.
# For running the test suite you do NOT need any of these (tests use the fake provider).

# Which provider backs the LLM + embeddings. One of: openai | fake
RAG_PROVIDER=openai

# OpenAI credentials + models (only used when RAG_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vector store persistence directory (Chroma)
RAG_PERSIST_DIR=.chroma
RAG_COLLECTION=rag_demo

# Retrieval / chunking tuning
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# Logging: DEBUG | INFO | WARNING | ERROR
RAG_LOG_LEVEL=INFO
